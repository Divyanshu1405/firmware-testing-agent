{
    "test_id": "MC_T05_PWM",
    "requirement_ids": [
        "R_MC_5"
    ],
    "duration_ms": 3000,
    "events": [
        {
            "at_ms": 500,
            "action": "ramp",
            "channel": "pwm_target",
            "to": 110.0,
            "over_ms": 1000,
            "expect_uart_contains": "PWM: CLAMPED MAX"
        },
        {
            "at_ms": 2000,
            "action": "step",
            "channel": "pwm_target",
            "value": -10,
            "expect_uart_contains": "PWM: CLAMPED MIN"
        }
    ]
}